# ════════════════════════════════════════════════════════════════════════════
# FINPILOT — production .env (шаблон). Копировать в .env в корне репозитория:
#   cp deploy/env.prod.example .env
# .env НЕ коммитится (см. .gitignore). Без обязательных секретов приложение
# не стартует — validate_production_security() в app/config.py падает fail-loud.
# Инструкция по шагам — docs/DEPLOY.md.
# ════════════════════════════════════════════════════════════════════════════

# ── Домен и данные PostgreSQL (нужны docker-compose.prod.yml) ───────────────
DOMAIN=твойдомен.ru
POSTGRES_PASSWORD=

# ── Обязательные секреты (fail-loud без них, см. validate_production_security) ─
# JWT_SECRET/ADMIN_API_KEY: openssl rand -hex 32 / -hex 24.
# TOKEN_ENCRYPTION_KEY: строго Fernet-ключ, НЕ openssl rand —
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
ADMIN_API_KEY=
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=true

# ── CORS: источник — сам домен по HTTPS (SPA и Jinja-страницы отдаются с него) ─
CORS_ORIGINS=https://твойдомен.ru,https://www.твойдомен.ru

# ── Почта (P1.5/П1.3): верификация e-mail, сброс пароля, дайджесты. ─────────
# Пусто = письма выключены (verification идёт по ссылке в ответе API). См. DEPLOY.md §3.1.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false

# ── Наблюдаемость ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# ── Юридические реквизиты оператора ПДн (152-ФЗ, P1.1) ──────────────────────
# Пока LEGAL_DETAILS_CONFIRMED=false — на юр-страницах виден баннер
# «документ в стадии оформления»; фейковые ИНН/адрес недопустимы.
LEGAL_OPERATOR_NAME=ООО «ФИНПАЙЛОТ»
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=support@finpilot.app
LEGAL_DOC_DATE=
LEGAL_DATA_RETENTION_MONTHS=6
LEGAL_DETAILS_CONFIRMED=false

# ── Опционально: B2B-контракт /v1/analyze, Plaid ────────────────────────────
# Пусто = соответствующий контур выключен.
B2B_API_KEYS=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
