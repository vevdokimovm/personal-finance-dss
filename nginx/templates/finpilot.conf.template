# ════════════════════════════════════════════════════════════════════════════
# FINPILOT — nginx reverse proxy + TLS (Let's Encrypt)
# ${DOMAIN} подставляется из .env при старте контейнера (envsubst).
# ════════════════════════════════════════════════════════════════════════════

# Поддержка WebSocket-апгрейда (на будущее; сейчас не используется).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP (80): ACME-challenge + редирект на HTTPS ───────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Внутренний healthcheck контейнера (до редиректа).
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Webroot для выпуска/обновления сертификата.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Всё остальное — на HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS (443): основной сервер ────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ── Заголовки безопасности (базовая гигиена финтех-продукта) ────────────
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options          "DENY" always;
    add_header X-Content-Type-Options   "nosniff" always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy       "geolocation=(), microphone=(), camera=()" always;
    # CSP: 'unsafe-inline' снят со СКРИПТОВ (v8.56.0) — Jinja снесена, собранный SPA
    # inline-скриптов не содержит. У стилей остаётся: Radix и react-remove-scroll ставят
    # их в рантайме. Политика обязана совпадать с `app/middleware.py`; расхождение
    # ловит `tests/test_csp_policy.py`.
    add_header Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Импорт банковских выписок — до 10 МБ, даём запас.
    client_max_body_size 12m;

    # Сжатие текстовых ответов.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Статика Jinja-страниц (css/js/images для contacts, legal/*, восстановления пароля).
    # 🔴 Блок `/static/` снят в v8.47.0 вместе с Jinja: каталог `frontend/static`
    # перенесён в архив (`docs/legacy_jinja/`), проксировать было бы некуда. Ассеты
    # React лежат в `/assets/` (ниже) и в корне сборки (иконки).

    # ── Файлы из КОРНЯ сборки: фавиконки, apple-touch-icon, robots.txt.
    # Без этого блока они уходят в `location /` на бэкенд, а тот отвечает `index.html`
    # (catch-all SPA) — браузер получает HTML вместо иконки и рисует пустую вкладку.
    # Кэш умеренный: имена без хэша, при замене иконки не должно ждать год.
    location ~* ^/[^/]+\.(?:ico|png|svg|webmanifest|txt)$ {
        root /usr/share/nginx/html;
        expires 7d;
        add_header Cache-Control "public";
        # Иконки могли и не попасть в сборку — тогда честный 404, а не страница-заглушка.
        try_files $uri =404;
    }

    # ── Легаси-алиас: /dashboard существовал до React SPA, канонический адрес
    # React-дашборда — "/" (index.tsx). Без этого редиректа старые закладки/ссылки на
    # /dashboard падали бы на легаси Jinja-дашборд с формой бюджета, не на актуальный
    # React-экран — найдено 2026-08-19, docs/ROADMAP.md §9.0 «A».
    location = /dashboard {
        return 301 /;
    }

    # ── SPA (React, веха 8): хэшированные ассеты сборки vite, кэш навечно ───────
    # Имена файлов содержат хэш контента (index-DobliUDD.js) — безопасно кэшировать
    # immutable, при новой сборке имя изменится само.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── SPA (React, веха 8): экраны приложения — отдаём index.html, роутинг на
    # клиенте (TanStack Router). Список — frontend/src/routes/*.tsx (кроме
    # __root.tsx). Добавили новый корневой экран во фронте — добавь его сюда.
    # login/register/forgot-password/reset-password (v8.22.0) заменяют собой легаси
    # Jinja-страницы forgot_password.html/reset_password.html (были живые, отдавались
    # FastAPI ниже) и никогда не существовавший login.html/register.html (в легаси вход
    # был JS-модалкой в общем base.html, недостижимой после переноса семи экранов на React).
    location ~ ^/(dashboard|planning|transactions|spending|obligations|goals|banks|profile|household|join|login|register|forgot-password|reset-password|legal|insights|experiments)(/|$) {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    location = / {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    # ── Всё остальное — FastAPI (gunicorn): /api, /v1 (B2B), /health, /docs,
    # второстепенные Jinja-экраны (contacts, legal/*, validation) — намеренно НЕ
    # перечисляем их поимённо здесь: любой путь, не забранный SPA-блоками выше,
    # безопасно попадает на бэкенд по умолчанию. Легаси forgot_password.html/
    # reset_password.html в app/main.py остаются (аварийный доступ мимо nginx,
    # тот же принцип, что у Jinja-версий семи уже перенесённых экранов, ROADMAP §8.2).
    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 60s;
    }
}
