# .env.example — образец конфигурации FINPILOT
#
# Скопируйте в `.env` рядом с этим файлом и отредактируйте под себя:
#     cp .env.example .env
#
# 🔴 СЕКРЕТЫ НЕ КОММИТЯТСЯ. Значения секретных полей ниже намеренно ПУСТЫЕ —
# заполняются только в `.env`, который в `.gitignore`. Пустой секрет означает,
# что соответствующая возможность выключена, а не что она сломана.
#
# Файл сгенерирован 29.08.2026 из `app/config.py` — единственного источника
# правды по настройкам. Все значения ниже это РЕАЛЬНЫЕ дефолты приложения,
# не выдуманные: README на `.env.example` ссылался, а самого файла не было
# (поймано гейтом ревизии).

# URL подключения к базе данных.
DATABASE_URL=sqlite:///./finpilot.db

# Режим отладки приложения.
DEBUG=False

# Префикс для API-маршрутов.
API_PREFIX=/api

# Название проекта.
PROJECT_NAME=FINPILOT

# Версия приложения (INFRA-13): код, UI-футер, git-тег.
APP_VERSION=8.28.0

# Подзаголовок продукта.
PROJECT_TAGLINE=Система поддержки принятия решений в персональных финансах

# Резервная ключевая ставка ЦБ (доля), если cbr.ru недоступен.
# по умолчанию в коде: 0.16 — в проде ОБЯЗАТЕЛЬНО заменить
CBR_KEY_RATE_FALLBACK=0.16

# Окружение: development | production (INFRA-10/12).
ENVIRONMENT=development
TELEMETRY_COLLECTION_ENABLED=False
CORS_ORIGINS=(

# Лимит запросов на чувствительные эндпоинты за окно (INFRA-12).
RATE_LIMIT_REQUESTS=30

# Размер окна rate-limit в секундах (INFRA-12).
RATE_LIMIT_WINDOW_SECONDS=60

# Секрет подписи JWT. В продакшне ОБЯЗАТЕЛЬНО задать в .env.
# по умолчанию в коде: dev-insecure-secret-change-me-in-production-env-32b — в проде ОБЯЗАТЕЛЬНО заменить
JWT_SECRET=

# Алгоритм подписи JWT.
JWT_ALGORITHM=HS256

# Срок жизни access-токена, часов.
JWT_TTL_HOURS=168

# Ключ доступа к админ-эндпоинтам (аналитика, cron-триггеры). 
ADMIN_API_KEY=

# Срок жизни токена сброса пароля, часов (P1.3).
# по умолчанию в коде: 1 — в проде ОБЯЗАТЕЛЬНО заменить
PASSWORD_RESET_TTL_HOURS=1

# DSN Sentry. Пусто = трекинг ошибок отключён.
SENTRY_DSN=

# Уровень логирования (DEBUG/INFO/WARNING).
LOG_LEVEL=INFO

# JSON-логи (True, для прода/агрегации) или человекочитаемый текст (False).
LOG_JSON=True

# Максимальный размер загружаемого файла выписки, МБ.
MAX_UPLOAD_SIZE_MB=10

# Имя httpOnly-cookie с JWT.
AUTH_COOKIE_NAME=fp_access

# Число неудачных попыток входа до временной блокировки аккаунта.
LOGIN_MAX_ATTEMPTS=5

# Длительность блокировки аккаунта после превышения лимита, минут.
LOGIN_LOCKOUT_MINUTES=15
COOKIE_SECURE=False

# Базовая валюта по умолчанию для новых пользователей.
DEFAULT_BASE_CURRENCY=RUB

# API-ключи партнёров через запятую. Пусто = эндпоинт отключён.
B2B_API_KEYS=

# Plaid client_id (sandbox/prod).
PLAID_CLIENT_ID=

# Plaid secret. Только через .env.
PLAID_SECRET=

# Окружение Plaid: sandbox | production.
# по умолчанию в коде: sandbox — в проде ОБЯЗАТЕЛЬНО заменить
PLAID_ENV=sandbox

# Fernet-ключ шифрования Plaid-токенов (INFRA-17). 
TOKEN_ENCRYPTION_KEY=

# Набор Fernet-ключей через запятую для ротации, PRIMARY первым 
TOKEN_ENCRYPTION_KEYS=

# SMTP-сервер. Пусто = почта отключена.
SMTP_HOST=

# Порт SMTP (587 STARTTLS / 465 SSL).
SMTP_PORT=587

# Логин SMTP.
SMTP_USER=

# Пароль/токен SMTP.
SMTP_PASSWORD=

# Адрес отправителя. Пусто = SMTP_USER.
SMTP_FROM=

# STARTTLS (True) или SSL (False).
SMTP_USE_TLS=True

# Токен бота от @BotFather. Пусто = выключен.
TELEGRAM_BOT_TOKEN=

# Username бота без @ (для deep link).
TELEGRAM_BOT_USERNAME=

# Secret для валидации webhook (заголовок X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# Наименование оператора ПДн (юрлицо/ИП). До регистрации — заглушка.
LEGAL_OPERATOR_NAME=ООО «ФИНПАЙЛОТ»

# ИНН оператора. Пусто = не заполнено (фейковый ИНН недопустим).
LEGAL_OPERATOR_INN=

# Юридический адрес оператора. Пусто = не заполнено.
LEGAL_OPERATOR_ADDRESS=

# Контактный e-mail для обращений (в т.ч. по ПДн). Домен — заглушка.
LEGAL_CONTACT_EMAIL=support@finpilot.app

# Дата вступления документов в силу (YYYY-MM-DD). Пусто = не указана.
LEGAL_DOC_DATE=

# Срок хранения данных после удаления учётной записи, месяцев.
LEGAL_DATA_RETENTION_MONTHS=6
LEGAL_DETAILS_CONFIRMED=False
