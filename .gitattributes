# Переводы строк: по умолчанию нормализуем к LF в репозитории.
* text=auto eol=lf

# ИСКЛЮЧЕНИЕ — эталонные фикстуры парсера выписок и сертификации.
# Их роль — быть неизменным байтовым образцом. Нормализация CRLF→LF меняет
# байты и хеши: падают golden-тесты (диффа в содержимом при этом НЕТ, искать
# долго), меняется поведение разбора там, где он опирается на границы строк,
# и теряется воспроизводимость прошлых раундов сертификации — данные раздачи
# экспертам перестают быть теми, на которых раунд проводился.
# Разбор: docs/reports/environment/crlf_in_parser_fixtures.md
app/data/statement_templates/*.csv          -text
docs/model/expert_certification/**/*.csv    -text

# Бинарные артефакты — без нормализации и без диффа.
*.zip    binary
*.gz     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
