[flake8]
max-line-length = 100
extend-ignore = F403, F405, F401
exclude = .venv, venv, __pycache__, .mypy_cache, .pytest_cache, alembic, build, dist, knowledge,
    # артефакты-улики независимых экспертных движков (сертификация): их стиль — часть улик,
    # реформат фальсифицировал бы поставленный экспертом код
    docs/model/expert_certification/iterations,
    # frontend/node_modules — вендоренный JS-стек (Э2 плана вехи 8); часть пакетов (katex,
    # flatted) несёт с собой служебные .py-скрипты не нашего авторства — не наш код, не линтуется
    frontend/node_modules,
    # _base — read-only зеркало системы «база», инжектируется на 63 репозитория и целиком
    # перезаписывается `_base/scripts/sync_base_local.py` (см. `_base/DO-NOT-EDIT.md`).
    # Не наш код и править его здесь нельзя: правка не переживёт следующую раздачу канона.
    # Без исключения `flake8 .` (команда из CLAUDE.md, «должно быть чисто») давал 163
    # нарушения, все до одного в `_base/`, в коде проекта — ноль. Тот же класс
    # гейта-с-ложной-уверенностью, что чинили в v8.30.1 для `revision_check.py::SKIP_DIRS`:
    # гейт спотыкается о чужое дерево и обесценивается ровно тем, что всегда красный.
    _base
# render_portrait_cards.py — research/рендер-скрипт: строки >100 это дословные выходные
# литералы досье-карточек и легенды (строки таблиц, проза), уходящие экспертам через
# knowledge/survey_auditory/. Перенос менял бы вывод; per-file-ignore вместо реформата
# (правило #2: массовый реформат запрещён). Ядро тестирования в этой же папке
# (generator/invariants/runner) линтуется как обычно.
per-file-ignores =
    tools/portrait_testing/render_portrait_cards.py: E501, E741
