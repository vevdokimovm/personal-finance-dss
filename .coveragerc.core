# Покрытие МАТЕМАТИЧЕСКОГО ЯДРА — отдельно от остального бэкенда.
#
# 🔴 Почему отдельный конфиг, а не общий порог.
#
# Ядро — третья сущность продукта, не часть бэкенда. Отличие не организационное,
# а по цене ошибки:
#
#   бэкенд сломался  → 500, человек видит отказ и повторит;
#   фронт сломался   → не отрисовалось, человек видит пустоту и пожалуется;
#   ЯДРО сломалось   → выдало НЕВЕРНЫЙ СОВЕТ О ДЕНЬГАХ, и человек ему поверил.
#
# Третий случай не даёт ни отказа, ни жалобы: продукт работает, числа выглядят
# правдоподобно, а человек гасит не тот долг. Единственный судья здесь — инварианты
# модели (`Rt ≥ 0`, ПДН ≤ 0.40, канон v3.9.0), а не HTTP-код.
#
# Поэтому порог выше общего: 95 против 90. Непокрытая ветка в роутере означает
# необработанный запрос; непокрытая ветка в ядре означает расчётный путь, по которому
# никто не проходил, — и он выдаст число, которое некому оспорить.
#
# Запуск: coverage run --rcfile=.coveragerc.core -m pytest tests/ && \
#         coverage report --rcfile=.coveragerc.core

[run]
source = app/core
omit =
    */__pycache__/*

[report]
exclude_also =
    logger\.info\(.*\)
    if __name__ == .__main__.:

fail_under = 95
precision = 2
show_missing = true
